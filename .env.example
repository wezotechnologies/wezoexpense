# ---------------------------------------------------------------------------
# Wezo Expense & Income Tracker — environment
# Copy to `.env` and fill in. Every value here is SERVER-ONLY.
# Nothing in this file may ever be prefixed NEXT_PUBLIC_ or reach the client.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Local development:
DATABASE_URL="postgresql://user@localhost:5432/wezo_expenses?schema=public"
#
# Azure Database for PostgreSQL (production). Note two things:
#   * sslmode=require — Azure refuses unencrypted connections.
#   * the password must be URL-encoded: @ becomes %40, # becomes %23, etc.
# DATABASE_URL="postgresql://USER:PASS%40WORD@SERVER.postgres.database.azure.com:5432/postgres?sslmode=require"

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"

# --- AI receipt reading -----------------------------------------------------
# Set one or both. Whichever model is selected in Settings decides which
# provider is called, so you can switch vendor without touching this file.
#
# Keys are matched to vendors by their own prefix (sk-ant-… is Anthropic), not
# by which variable they sit in — so swapping these two by mistake cannot leak
# a key to the wrong API.
#
# Leave both blank and receipt reading is skipped; the manual form still works.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
#
# Default model. Settings overrides it and shows each model's measured cost per
# receipt. gpt-4.1-mini is the cheapest accurate option — note that gpt-4o-mini
# is ~5x DEARER per receipt despite a lower token price, because it spends
# 25,527 image tokens on a receipt where gpt-4.1-mini spends 933.
OPENAI_MODEL="gpt-4.1-mini"

# --- Receipt storage --------------------------------------------------------
# Azure Blob. Keep the container PRIVATE — the app mints a short-lived,
# read-only SAS per request and never makes a blob public.
# Leave blank in development and receipts go to a gitignored local folder.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER="wezo-receipts"

# --- Seed -------------------------------------------------------------------
# Used once by `npm run db:seed` to create the first Superadmin, who is then
# forced to replace this password on first sign-in.
SUPERADMIN_EMAIL="owner@wezo.co"
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME="Wezo Superadmin"

# --- Recurring scheduler ----------------------------------------------------
# You invent this value; it is not issued by any service. It is a shared
# password between the app and whatever calls the cron route.
#   generate:  openssl rand -hex 32
#   scheduler sends:  Authorization: Bearer <CRON_SECRET>
# Leave blank and the endpoint accepts only a signed-in Admin (manual runs
# from the Recurring screen still work).
CRON_SECRET=
